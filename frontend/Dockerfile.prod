FROM node:20-alpine AS build

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install

COPY . .

# EC2のhairpin NAT対策でSPAモードに切り替える場合に使用（PR #11参照）。
# nuxt.config.tsのssr設定はビルド時に評価されるため、ここでビルド引数として受け取る。
ARG NUXT_SSR=true
ENV NUXT_SSR=$NUXT_SSR
RUN npm run build

FROM node:20-alpine

WORKDIR /app

ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000

COPY --from=build /app/.output ./.output

EXPOSE 3000

CMD ["node", ".output/server/index.mjs"]
